# OpenRouter - primary LLM provider (free credits, better models than Groq)
# Get your key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxx

# Optional: override the free models without touching code. OpenRouter rotates
# its free tier often - if a slug 404s, grab a live one from
# https://openrouter.ai/models?max_price=0 and paste it here.
# OPENROUTER_SCRAPE_MODEL=openrouter/nvidia/nemotron-3.5-lightning:free
# OPENROUTER_DEEP_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free

# Groq - fallback LLM provider (used if OpenRouter key is missing)
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxx

# Tavily - required for real-time web search
TAVILY_API_KEY=tvly_xxxxxxxxxxxxxxxxxxxxxxxx

# DeepInfra - optional, used for the Batch API mode (~20% cheaper)
# DEEPINFRA_API_KEY=